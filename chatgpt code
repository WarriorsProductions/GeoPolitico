                        <div class="profile-stat-label">National GDP</div>
                    </div>
                    <div class="profile-stat-card">
                        <div class="profile-stat-icon">⚔️</div>
                        <div class="profile-stat-value">156K</div>
                        <div class="profile-stat-label">Military Strength</div>
                    </div>
                </div>

                <div class="card">
                    <h2>🏆 Recent Achievements</h2>
                    <div style="display: grid; gap: 1rem; margin-top: 1rem;">
                        <div style="display: flex; align-items: center; gap: 1rem; padding: 1rem; background: #f8f9fa; border-radius: 8px;">
                            <div style="font-size: 2rem;">🥇</div>
                            <div>
                                <strong>Climate Summit Success</strong>
                                <div style="color: #7f8c8d; font-size: 0.9rem;">Led international climate negotiations</div>
                            </div>
                        </div>
                        <div style="display: flex; align-items: center; gap: 1rem; padding: 1rem; background: #f8f9fa; border-radius: 8px;">
                            <div style="font-size: 2rem;">📈</div>
                            <div>
                                <strong>Economic Growth</strong>
                                <div style="color: #7f8c8d; font-size: 0.9rem;">Achieved 4.2% GDP growth this quarter</div>
                            </div>
                        </div>
                        <div style="display: flex; align-items: center; gap: 1rem; padding: 1rem; background: #f8f9fa; border-radius: 8px;">
                            <div style="font-size: 2rem;">🕊️</div>
                            <div>
                                <strong>Peace Mediator</strong>
                                <div style="color: #7f8c8d; font-size: 0.9rem;">Successfully mediated regional conflict</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 2rem;">
                    <div class="card">
                        <h3>📊 Policy Focus</h3>
                        <div style="margin-top: 1rem;">
                            <div style="margin-bottom: 1rem;">
                                <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                                    <span>Economy</span>
                                    <span style="color: #e74c3c; font-weight: bold;">85%</span>
                                </div>
                                <div style="background: #ecf0f1; height: 8px; border-radius: 4px;">
                                    <div style="background: #e74c3c; height: 100%; width: 85%; border-radius: 4px;"></div>
                                </div>
                            </div>
                            <div style="margin-bottom: 1rem;">
                                <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                                    <span>Environment</span>
                                    <span style="color: #27ae60; font-weight: bold;">72%</span>
                                </div>
                                <div style="background: #ecf0f1; height: 8px; border-radius: 4px;">
                                    <div style="background: #27ae60; height: 100%; width: 72%; border-radius: 4px;"></div>
                                </div>
                            </div>
                            <div>
                                <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                                    <span>Defense</span>
                                    <span style="color: #f39c12; font-weight: bold;">64%</span>
                                </div>
                                <div style="background: #ecf0f1; height: 8px; border-radius: 4px;">
                                    <div style="background: #f39c12; height: 100%; width: 64%; border-radius: 4px;"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <h3>🌐 Global Relations</h3>
                        <div style="margin-top: 1rem;">
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.8rem 0; border-bottom: 1px solid #ecf0f1;">
                                <span>🇺🇸 United States</span>
                                <span style="color: #27ae60; font-weight: bold;">Allied</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.8rem 0; border-bottom: 1px solid #ecf0f1;">
                                <span>🇪🇺 European Union</span>
                                <span style="color: #3498db; font-weight: bold;">Friendly</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.8rem 0; border-bottom: 1px solid #ecf0f1;">
                                <span>🇨🇳 China</span>
                                <span style="color: #f39c12; font-weight: bold;">Neutral</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.8rem 0;">
                                <span>🇷🇺 Russia</span>
                                <span style="color: #e74c3c; font-weight: bold;">Tense</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Page navigation
        function showPage(pageId) {
            document.querySelectorAll('.page').forEach(page => {
                page.classList.remove('active');
            });
            document.getElementById(pageId).classList.add('active');
        }

        function showProfile() {
            showPage('profile-page');
        }

        function goBack() {
            showPage('home-page');
        }

        // Game functionality
        function navigateTo(page) {
            const pages = {
                home: 'Home page - Main dashboard with current simulation status',
                leaders: 'Leaders page - View world leaders and their approval ratings',
                actions: 'Actions page - Comprehensive list of available political actions',
                regions: 'Regions page - Detailed view of all nations and territories',
                parties: 'Parties page - Political parties and their ideologies worldwide',
                messages: 'Messages page - Diplomatic communications and announcements',
                worldmap: 'World Map - Interactive global political map'
            };
            alert(`Navigating to: ${pages[page] || 'Unknown page'}`);
        }

        function startGame() {
            const button = event.target;
            const originalText = button.textContent;
            button.innerHTML = '<span class="loading"></span> Loading...';
            button.disabled = true;
            
            setTimeout(() => {
                alert('Welcome to GEOPOLITICO! Tutorial will begin shortly.');
                button.textContent = originalText;
                button.disabled = false;
            }, 2000);
        }

        function viewTutorial() {
            alert('Tutorial: Learn the basics of political simulation, economic management, and diplomatic relations.');
        }

        function viewEvents() {
            alert('Global Events Dashboard - Monitor real-time political and economic developments.');
        }

        function performAction(action) {
            const actions = {
                trade: 'Trade negotiations initiated. Your economic advisors are preparing proposals.',
                diplomacy: 'Diplomatic mission launched. Your ambassador is en route.',
                military: 'Military command center activated. Strategic options available.',
                economy: 'Economic policy review initiated. Finance ministers are consulting.',
                research: 'Research funding allocated. Science advisors are prioritizing projects.'
            };
            alert(actions[action] || 'Action executed successfully.');
        }

        function showStats() {
            alert('Statistics Dashboard - Comprehensive analysis of your nation\'s performance and global rankings.');
        }

        function followGame() {
            alert('Thank you for following GEOPOLITICO! You\'ll receive updates on major simulation events.');
        }

        function joinDiscord() {
            alert('Discord community link would open here. Connect with other political strategists!');
        }

        // Navigation highlighting
        document.querySelectorAll('.nav a').forEach(link => {
            link.addEventListener('click', function(e) {
                if (this.getAttribute('href') === '#') {
                    e.preventDefault();
                }
                document.querySelectorAll('.nav a').forEach(l => l.classList.remove('active'));
                this.classList.add('active');
            });
        });

        // Dynamic stats update
        function updateStats() {
            const stats = document.querySelectorAll('.stat-number');
            stats.forEach(stat => {
                const value = parseInt(stat.textContent);
                const variation = Math.floor(Math.random() * 5) - 2;
                if (stat.textContent.includes('$')) {
                    // Handle monetary values
                    const newValue = Math.max(0, value + variation * 0.1);
                    stat.textContent = '$' + newValue.toFixed(1) + 'T';
                } else if (stat.textContent.includes('%')) {
                    // Handle percentages
                    const newValue = Math.max(0, Math.min(100, value + variation));
                    stat.textContent = newValue + '%';
                } else {
                    // Handle regular numbers
                    const newValue = Math.max(0, value + variation);
                    stat.textContent = newValue;
                }
            });
        }

        // Update stats every 30 seconds for dynamic feel
        setInterval(updateStats, 30000);

        // Add some interactive hover effects
        document.querySelectorAll('.card').forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-5px) scale(1.02)';
            });
            
            card.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0) scale(1)';
            });
        });
    </script>
</body>
</html>
